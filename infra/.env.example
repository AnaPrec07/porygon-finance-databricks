# Copy to infra/.env (git-ignored) and fill in. Never commit real values.
AWS_ACCOUNT_ID=
LANDING_BUCKET=
UC_MASTER_ROLE_ARN=
# optional
UC_ROLE_NAME=databricks-uc-landing-zone
LANDING_GRANTEE_GROUP=data-engineers
# for `databricks bundle deploy -t dev` from your machine
BUNDLE_VAR_landing_s3_url=s3://<your-bucket>/landing
